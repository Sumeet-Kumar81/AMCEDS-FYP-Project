{
  "name": "amceds-frontend",
  "private": true,
  "description": "AMCEDS web apps: dispatcher dashboard, public report page and the shared client/UI kit (SIMULATED data only).",
  "type": "module",
  "workspaces": [
    "shared",
    "dashboard",
    "pwa"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:dashboard": "npm run dev -w dashboard",
    "dev:pwa": "npm run dev -w pwa",
    "build": "npm run build -w dashboard && npm run build -w pwa",
    "typecheck": "tsc -p shared && tsc -p dashboard && tsc -p pwa",
    "test": "vitest run",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:check": "node scripts/gen-api.mjs --check"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
