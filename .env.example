# ---- Database ----
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dispatch
DATABASE_URL=postgresql+asyncpg://dispatch:change_me@postgres:5432/dispatch

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=30

# ---- LLM Gateway (groq | gemini | ollama) ----
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
OLLAMA_URL=http://ollama:11434

# ---- Routing / geocoding ----
OSRM_URL=http://osrm:5000
NOMINATIM_URL=https://nominatim.openstreetmap.org

# ---- Business rules: defaults only; the database settings table (app/services/settings.py) is authoritative ----
PATIENTS_PER_AMBULANCE=2
DUP_DISTANCE_M=300
DUP_WINDOW_MIN=15
DUP_AUTO_LINK=85
DUP_POSSIBLE=60
TRIAGE_MIN_CONFIDENCE=60

# ---- Seed accounts (python -m app.seed); leave empty to skip that role. Never commit real values ----
SEED_ADMIN_PASSWORD=
SEED_DISPATCHER_PASSWORD=
SEED_DRIVER_PASSWORD=

# ---- App ----
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
